# Compiler files
cache/
out/

# Foundry vendored libs — installed via `forge install`. Each is its own git
# repo at lib/<name>/.git which would otherwise show up as a broken submodule
# pointer in this repo's index.
lib/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example
