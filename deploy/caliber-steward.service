[Unit]
Description=Caliber Steward — payment authorization proxy (CFO layer)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=huicom
WorkingDirectory=/home/huicom/arc-agents-explorer/services/steward
EnvironmentFile=/home/huicom/arc-agents-explorer/.env
Environment=PATH=/home/huicom/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
# Long-running HTTP API on :3300 (STEWARD_PORT). Agents POST a payment intent;
# Steward probes the seller's x402 quote, runs the authorize() pipeline
# (freeze/policy/detectors/SDN/treasurer), pays if allowed, and ledgers every
# decision. The web console (steward.poko.blue) proxies the public surface.
ExecStart=/home/huicom/.npm-global/bin/pnpm --filter @caliber/steward start
Restart=always
RestartSec=5
StandardOutput=append:/var/log/caliber-steward.log
StandardError=append:/var/log/caliber-steward-err.log
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
