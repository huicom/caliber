    "express": "^5.1.0",
    "viem": "^2.27.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
